{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@hive-flow/cli": [
        "../cli/src"
      ],
      "@hive-flow/cli/*": [
        "../cli/src/*"
      ],
      "@hive-flow/embeddings": [
        "./@hive-flow/embeddings/src"
      ],
      "@hive-flow/providers": [
        "./@hive-flow/providers/src"
      ]
    }
  },
  "references": [
    {
      "path": "../cli"
    },
    {
      "path": "./@hive-flow/embeddings"
    },
    {
      "path": "./@hive-flow/providers"
    }
  ],
  "include": [],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
