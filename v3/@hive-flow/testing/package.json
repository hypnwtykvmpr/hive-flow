{
  "name": "@hive-flow/testing",
  "version": "3.0.0-alpha.6",
  "type": "module",
  "description": "Testing module - TDD London School framework, test utilities, fixtures, and mock services for V3 Hive-Flow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hive-flow",
    "testing",
    "vitest",
    "tdd",
    "london-school",
    "mocks",
    "fixtures"
  ],
  "peerDependencies": {
    "@hive-flow/memory": "workspace:*",
    "@hive-flow/shared": "workspace:*",
    "@hive-flow/swarm": "workspace:*",
    "fast-check": ">=4.0.0",
    "vitest": ">=1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@hive-flow/memory": "workspace:*",
    "@hive-flow/shared": "workspace:*",
    "@hive-flow/swarm": "workspace:*",
    "fast-check": "^4.8.0",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
