{
  "name": "@hive-flow/claims",
  "version": "3.0.0-alpha.8",
  "description": "Issue claiming and work coordination module for Hive Flow V3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./api/mcp-tools": {
      "import": "./dist/api/mcp-tools.js",
      "require": "./dist/api/mcp-tools.js",
      "types": "./dist/api/mcp-tools.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hive-flow",
    "claims",
    "issue-tracking",
    "work-coordination",
    "multi-agent",
    "swarm",
    "mcp"
  ],
  "author": "Hive Flow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypnwtykvmpr/hive-flow.git",
    "directory": "v3/@hive-flow/claims"
  },
  "bugs": {
    "url": "https://github.com/hypnwtykvmpr/hive-flow/issues"
  },
  "homepage": "https://github.com/hypnwtykvmpr/hive-flow#readme",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
"tsup": "^8.0.1",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@hive-flow/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hive-flow/shared": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
