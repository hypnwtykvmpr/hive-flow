{
  "name": "@hive-flow/embeddings",
  "version": "3.0.0-alpha.12",
  "description": "V3 Embedding Service - OpenAI, Transformers.js, RVF, and mock providers with hyperbolic embeddings, normalization, and chunking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "embeddings",
    "openai",
    "transformers",
    "vector",
    "similarity",
    "hive-flow",
    "v3",
    "hyperbolic",
    "poincare",
    "normalization",
    "chunking",
    "neural-substrate"
  ],
  "author": "Hive Flow Team",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "sql.js": "^1.14.1",
    "@hive-flow/shared": "workspace:*",
    "@hive-flow/integration": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
