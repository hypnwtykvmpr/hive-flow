{
  "name": "@hive-flow/browser",
  "version": "3.0.0-alpha.2",
  "description": "Browser automation for AI agents - integrates agent-browser with hive-flow swarms",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp-tools": "./dist/mcp-tools/index.js",
    "./skill": "./dist/skill/index.js",
    "./agent": "./dist/agent/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agent-browser": "^0.6.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@hive-flow/cli": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.0.0"
  },
  "keywords": [
    "browser",
    "automation",
    "ai-agent",
    "hive-flow",
    "playwright",
    "web-scraping",
    "testing"
  ],
  "author": "hypnwtykvmpr",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
