{
  "name": "@hive-flow/plugins",
  "version": "3.0.0-alpha.7",
  "description": "Unified Plugin SDK for Hive Flow V3 - Worker, Hook, and Provider Integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.js",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.js",
      "import": "./dist/sdk/index.js"
    },
    "./workers": {
      "types": "./dist/workers/index.d.js",
      "import": "./dist/workers/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.js",
      "import": "./dist/hooks/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.js",
      "import": "./dist/providers/index.js"
    },
    "./examples/plugin-creator": {
      "types": "./dist/examples/plugin-creator/index.d.js",
      "import": "./dist/examples/plugin-creator/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@hive-flow/shared": "workspace:*",
    "@hive-flow/hooks": "workspace:*",
    "@hive-flow/memory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hive-flow/hooks": {
      "optional": true
    },
    "@hive-flow/memory": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^4.0.16"
  },
  "keywords": [
    "hive-flow",
    "plugins",
    "sdk",
    "workers",
    "hooks",
    "ai-agents",
    "hnsw",
    "vector-search",
    "lora",
    "neural-adaptation"
  ],
  "author": "Hive Flow Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
