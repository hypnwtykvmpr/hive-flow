{
  "name": "@hive-flow/integration",
  "version": "3.0.0",
  "type": "module",
  "description": "Hive Flow integration utilities for local learning, attention, workers, and provider routing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./token-optimizer": "./dist/token-optimizer.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hive-flow",
    "token-optimizer",
    "reasoningbank",
    "anti-drift",
    "swarm"
  ],
  "dependencies": {
    "@hive-flow/shared": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  },
  "hive-flow": {
    "optionalComponents": {
      "TokenOptimizer": {
        "description": "Token reduction via local cache and conservative routing defaults",
        "savings": "reduced",
        "features": [
          "ReasoningBank",
          "cache",
          "anti-drift-config"
        ]
      }
    }
  }
}
