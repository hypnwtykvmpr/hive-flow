{
  "name": "@hive-flow/cli",
  "version": "3.1.0-alpha.52",
  "type": "module",
  "description": "Hive Flow CLI - Enterprise AI agent orchestration with 60+ specialized agents, swarm coordination, MCP server, self-learning hooks, and vector memory for Claude Code",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "bin": {
    "cli": "./bin/cli.js",
    "hive-flow": "./bin/cli.js",
    "hive-flow-mcp": "./bin/mcp-server.js",
    "hive-flow-statusline": "./bin/statusline.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai-agents",
    "multi-agent",
    "swarm",
    "mcp",
    "model-context-protocol",
    "llm",
    "cli",
    "orchestration",
    "automation",
    "developer-tools",
    "coding-assistant",
    "vector-database",
    "embeddings",
    "self-learning",
    "enterprise"
  ],
  "contributors": [
    {
      "name": "Hive Flow"
    }
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./hivector": {
      "types": "./dist/src/hivector/index.d.ts",
      "import": "./dist/src/hivector/index.js"
    },
    "./hivector/*": {
      "types": "./dist/src/hivector/*.d.ts",
      "import": "./dist/src/hivector/*.js"
    },
    "./package.json": "./package.json",
    "./mcp-tools": {
      "types": "./dist/src/mcp-tools/index.d.ts",
      "import": "./dist/src/mcp-tools/index.js"
    },
    "./deployment": {
      "types": "./dist/src/deployment/index.d.ts",
      "import": "./dist/src/deployment/index.js"
    },
    "./performance": {
      "types": "./dist/src/performance/index.d.ts",
      "import": "./dist/src/performance/index.js"
    },
    "./performance/*": {
      "types": "./dist/src/performance/*.d.ts",
      "import": "./dist/src/performance/*.js"
    },
    "./claims": {
      "types": "./dist/src/claims/index.d.ts",
      "import": "./dist/src/claims/index.js"
    },
    "./claims/*": {
      "types": "./dist/src/claims/*.d.ts",
      "import": "./dist/src/claims/*.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "scripts/verify-appliance.sh",
    "helpers/**",
    "agents/**/*.yaml",
    ".claude/commands/**",
    ".claude/helpers/**",
    ".claude/skills/**",
    ".claude/settings.json",
    "!.claude/**/DELETE_*",
    "!**/DELETE_*",
    "!.claude/**/.hive-flow/**",
    "!.claude/**/*.db",
    "!.claude/**/*.db-shm",
    "!.claude/**/*.db-wal",
    "!.claude/**/*.db-journal",
    "!.claude/**/.context-tracker.json",
    "!.claude/**/checkpoints/**",
    "!**/*.map",
    "README.md"
  ],
  "scripts": {
    "build:helpers-src": "node scripts/copy-helper-sources.mjs",
    "build": "tsc && npm run build:helpers-src && node scripts/sync-engine-anchor.mjs",
    "sync:engine": "node scripts/sync-engine-anchor.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e:anti-mock": "vitest run --config e2e/vitest.config.ts __tests__/anti-mock-theater.test.ts",
    "test:debrand-assert-zero": "vitest run src/init/__tests__/debrand-generator-output.test.ts src/init/__tests__/perf-claims-grep-zero.test.ts src/init/__tests__/dropped-integration-grep-zero.test.ts src/init/__tests__/debrand-static-grep-zero.test.ts src/init/__tests__/debrand-ru-suspect-classification.test.ts",
    "test:property": "vitest run src/statusline/__tests__/property-contracts.test.ts",
    "test:sentinel": "vitest run src/__tests__/sentinel-rewake.test.ts src/__tests__/mcp-server-notifications.test.ts",
    "test:enforcement": "vitest run src/__tests__/band1-enforcement.test.ts src/__tests__/role-enforcement.test.ts src/__tests__/pipeline-enforcement.test.ts src/__tests__/enforcement-security-property.test.ts src/__tests__/relocated-engine-root.test.ts",
    "test:plugin-store": "tsx src/plugins/tests/standalone-test.ts",
    "test:pattern-store": "tsx src/transfer/store/tests/standalone-test.ts",
    "bench:performance": "vitest bench benchmarks/performance",
    "bench:performance:attention": "vitest bench benchmarks/performance/attention",
    "mutation:critical": "stryker run stryker.critical.conf.json",
    "preinstall": "node bin/preinstall.cjs || true",
    "prepublishOnly": "cp ../../../README.md ./README.md",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "release": "npm version prerelease --preid=alpha && npm run publish:all",
    "publish:all": "./scripts/publish.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@hive-flow/plugins": "workspace:*",
    "@hive-flow/swarm": "workspace:*",
    "fast-check": "^4.8.0",
    "sql.js": "^1.14.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.43.0",
    "@hive-flow/mcp": "workspace:*",
    "@hive-flow/shared": "workspace:*",
    "@noble/ed25519": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.7.4",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "@hive-flow/aidefence": "workspace:*",
    "@hive-flow/codex": "workspace:*",
    "@hive-flow/providers": "workspace:*",
    "@hive-flow/embeddings": "workspace:*",
    "@hive-flow/guidance": "workspace:*",
    "@hive-flow/memory": "workspace:*",
    "@hive-flow/integration": "workspace:*",
    "@hive-flow/neural": "workspace:*",
    "@hive-flow/plugin-gastown-bridge": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
