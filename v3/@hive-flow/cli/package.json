{
  "name": "@hive-flow/cli",
  "version": "3.1.0-alpha.52",
  "type": "module",
  "description": "Hive Flow CLI - Enterprise AI agent orchestration with 60+ specialized agents, swarm coordination, MCP server, self-learning hooks, and vector memory for Claude Code",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "bin": {
    "cli": "./bin/cli.js",
    "hive-flow": "./bin/cli.js",
    "hive-flow-mcp": "./bin/mcp-server.js"
  },
  "homepage": "https://github.com/hypnwtykvmpr/hive-flow#readme",
  "bugs": {
    "url": "https://github.com/hypnwtykvmpr/hive-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hypnwtykvmpr/hive-flow.git",
    "directory": "v3/@hive-flow/cli"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai-agents",
    "multi-agent",
    "swarm",
    "mcp",
    "model-context-protocol",
    "llm",
    "cli",
    "orchestration",
    "automation",
    "developer-tools",
    "coding-assistant",
    "vector-database",
    "embeddings",
    "self-learning",
    "enterprise"
  ],
  "contributors": [
    {
      "name": "RuvNet",
      "url": "https://github.com/ruvnet"
    }
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ruvector": {
      "types": "./dist/src/ruvector/index.d.ts",
      "import": "./dist/src/ruvector/index.js"
    },
    "./ruvector/*": {
      "types": "./dist/src/ruvector/*.d.ts",
      "import": "./dist/src/ruvector/*.js"
    },
    "./mcp-tools": {
      "types": "./dist/src/mcp-tools/index.d.ts",
      "import": "./dist/src/mcp-tools/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    ".claude",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:plugin-store": "npx tsx src/plugins/tests/standalone-test.ts",
    "test:pattern-store": "npx tsx src/transfer/store/tests/standalone-test.ts",
    "preinstall": "node bin/preinstall.cjs || true",
    "prepublishOnly": "cp ../../../README.md ./README.md",
    "typecheck": "tsc --noEmit",
    "release": "npm version prerelease --preid=alpha && npm run publish:all",
    "publish:all": "./scripts/publish.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@hive-flow/mcp": "workspace:*",
    "@hive-flow/shared": "workspace:*",
    "@noble/ed25519": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.7.4"
  },
  "optionalDependencies": {
    "@hive-flow/aidefence": "workspace:*",
    "@hive-flow/codex": "workspace:*",
    "@hive-flow/providers": "workspace:*",
    "@hive-flow/embeddings": "workspace:*",
    "@hive-flow/guidance": "workspace:*",
    "@hive-flow/memory": "workspace:*",
    "@hive-flow/integration": "workspace:*",
    "@hive-flow/neural": "workspace:*",
    "@hive-flow/plugin-gastown-bridge": "workspace:*",
    "agentic-flow": "^3.0.0-alpha.1",
    "@ruvector/attention": "^0.1.31",
    "@ruvector/learning-wasm": "^0.1.29",
    "@ruvector/router": "^0.1.27",
    "@ruvector/sona": "^0.1.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
