{
  "name": "@hive-flow/plugin-agentic-qe",
  "version": "3.0.0-alpha.4",
  "description": "Quality Engineering plugin for Hive Flow V3 with 51 specialized agents across 12 DDD bounded contexts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "plugin.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hive-flow",
    "plugin",
    "quality-engineering",
    "testing",
    "coverage",
    "tdd",
    "security",
    "chaos-engineering",
    "accessibility",
    "ai-agents"
  ],
  "author": "Hive Flow",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@hive-flow/embeddings": "workspace:*",
    "@hive-flow/cli": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hive-flow/embeddings": {
      "optional": true
    },
    "@hive-flow/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
