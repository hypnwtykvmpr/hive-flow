{
  "name": "@hive-flow/v3-monorepo",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Hive Flow V3 - Modular AI Agent Coordination System",
  "workspaces": [
    "@hive-flow/*",
    "hive-flow"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:integration:watch": "vitest watch __tests__/integration",
    "test:integration:memory": "vitest run __tests__/integration/memory-integration.test.ts",
    "test:integration:swarm": "vitest run __tests__/integration/swarm-integration.test.ts",
    "test:integration:mcp": "vitest run __tests__/integration/mcp-integration.test.ts",
    "test:integration:plugin": "vitest run __tests__/integration/plugin-integration.test.ts",
    "test:integration:workflow": "vitest run __tests__/integration/workflow-integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:integration": "vitest run __tests__/integration --coverage",
    "test:hardening:pr": "pnpm --filter @hive-flow/testing test && pnpm --filter @hive-flow/cli test:property && pnpm --filter @hive-flow/cli test:sentinel && pnpm --filter @hive-flow/cli test:enforcement && pnpm --filter @hive-flow/providers test:provider-hardening",
    "test:hardening:deep": "HIVE_FLOW_PROPERTY_RUNS=1000 pnpm test:hardening:pr",
    "test:bats": "bash scripts/run-bats.sh",
    "test:security": "pnpm --filter @hive-flow/security test",
    "test:memory": "pnpm --filter @hive-flow/memory test",
    "test:swarm": "pnpm --filter @hive-flow/swarm test",
    "bench": "pnpm --filter @hive-flow/performance bench",
    "bench:attention": "pnpm --filter @hive-flow/performance bench:attention",
    "knip": "knip --config knip.json",
    "mutation:critical": "pnpm --filter @hive-flow/cli mutation:critical",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf node_modules @hive-flow/*/node_modules hive-flow/node_modules",
    "publish:dry": "pnpm --filter hive-flow publish --dry-run --tag v3alpha --no-git-checks",
    "publish:v3alpha": "pnpm --filter hive-flow publish --tag v3alpha --no-git-checks",
    "version:patch": "pnpm -r exec npm version patch",
    "version:minor": "pnpm -r exec npm version minor",
    "version:major": "pnpm -r exec npm version major",
    "bun:install": "bun install",
    "bun:build": "bun run --filter '*' build",
    "bun:test": "bun test",
    "bun:dev": "bun run --watch src/index.ts",
    "bun:publish:dry": "cd hive-flow && bun publish --dry-run --tag v3alpha",
    "bun:publish:v3alpha": "cd hive-flow && bun publish --tag v3alpha"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.0.0",
    "knip": "^6.15.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "semantic-release": "25.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": ["sharp"],
    "patchedDependencies": {
      "agentdb@3.0.0-alpha.9": "patches/agentdb@3.0.0-alpha.9.patch"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@hive-flow/browser",
        "@hive-flow/coordination",
        "@hive-flow/embeddings",
        "@hive-flow/memory",
        "@hive-flow/plugins",
        "@hive-flow/security"
      ]
    },
    "overrides": {
      "tar": ">=7.6.0",
      "node-gyp": "^10.0.0",
      "undici": ">=7.26.0 <8",
      "@anthropic-ai/sdk": ">=0.98.0",
      "@modelcontextprotocol/sdk": ">=1.26.0",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "qs": ">=6.15.0",
      "minimatch": ">=9.1.0",
      "@hono/node-server": ">=1.19.10",
      "axios": ">=1.13.6",
      "express-rate-limit": ">=8.3.0",
      "hono": ">=4.12.5",
      "diff": ">=8.0.3"
    }
  }
}
