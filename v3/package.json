{
  "name": "@hive-flow/v3-monorepo",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Hive Flow V3 - Modular AI Agent Coordination System",
  "workspaces": [
    "@hive-flow/*",
    "hive-flow"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "pnpm --filter @hive-flow/cli test:e2e",
    "test:integration:watch": "pnpm --filter @hive-flow/cli exec vitest watch --config e2e/vitest.config.ts",
    "test:integration:memory": "pnpm --filter @hive-flow/cli exec vitest run --config e2e/vitest.config.ts __tests__/memory.e2e.test.ts",
    "test:integration:swarm": "pnpm --filter @hive-flow/cli exec vitest run --config e2e/vitest.config.ts __tests__/swarm.e2e.test.ts",
    "test:integration:mcp": "pnpm --filter @hive-flow/cli exec vitest run --config e2e/vitest.config.ts __tests__/mcp.e2e.test.ts",
    "test:integration:plugin": "pnpm --filter @hive-flow/cli exec vitest run --config e2e/vitest.config.ts __tests__/plugin.e2e.test.ts",
    "test:integration:workflow": "pnpm --filter @hive-flow/cli exec vitest run --config e2e/vitest.config.ts __tests__/workflow.e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:integration": "vitest run __tests__/integration --coverage",
    "test:hardening:pr": "pnpm --filter @hive-flow/cli test:testing && pnpm --filter @hive-flow/cli test:property && pnpm --filter @hive-flow/cli test:sentinel && pnpm --filter @hive-flow/cli test:enforcement && pnpm --filter @hive-flow/providers test:provider-hardening",
    "test:hardening:deep": "HIVE_FLOW_PROPERTY_RUNS=1000 pnpm test:hardening:pr",
    "test:bats": "bash scripts/run-bats.sh",
    "test:security": "pnpm --filter @hive-flow/cli exec vitest run src/security/__tests__",
    "test:memory": "pnpm --filter @hive-flow/memory test",
    "test:swarm": "pnpm --filter @hive-flow/cli exec vitest run src/swarm/__tests__",
    "bench": "pnpm --filter @hive-flow/cli bench:performance",
    "bench:attention": "pnpm --filter @hive-flow/cli bench:performance:attention",
    "knip": "knip --config knip.json",
    "mutation:critical": "pnpm --filter @hive-flow/cli mutation:critical",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf node_modules @hive-flow/*/node_modules hive-flow/node_modules",
    "publish:dry": "pnpm --filter hive-flow publish --dry-run --tag v3alpha --no-git-checks",
    "publish:v3alpha": "pnpm --filter hive-flow publish --tag v3alpha --no-git-checks",
    "version:patch": "pnpm -r exec npm version patch",
    "version:minor": "pnpm -r exec npm version minor",
    "version:major": "pnpm -r exec npm version major",
    "bun:install": "bun install",
    "bun:build": "bun run --filter '*' build",
    "bun:test": "bun test",
    "bun:dev": "bun run --watch src/index.ts",
    "bun:publish:dry": "cd hive-flow && bun publish --dry-run --tag v3alpha",
    "bun:publish:v3alpha": "cd hive-flow && bun publish --tag v3alpha"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.0.0",
    "knip": "^6.15.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "semantic-release": "25.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": ["sharp"],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@hive-flow/coordination",
        "@hive-flow/embeddings",
        "@hive-flow/memory",
        "@hive-flow/plugins"
      ]
    },
    "overrides": {
      "tar": ">=7.6.0",
      "node-gyp": "^10.0.0",
      "undici@<6.27.0": "^6.27.0",
      "undici@>=7.0.0 <7.28.0": "^7.28.0",
      "@anthropic-ai/sdk": ">=0.98.0",
      "@modelcontextprotocol/sdk": ">=1.26.0",
      "rollup": ">=4.59.0",
      "esbuild@>=0.17.0 <0.28.1": "0.28.1",
      "qs@>=6.11.1 <6.15.2": "6.15.2",
      "minimatch": ">=9.1.0",
      "fast-uri@<3.1.2": "3.1.2",
      "flatted@<3.4.2": "3.4.2",
      "lodash-es@<4.18.0": "4.18.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "postcss@<8.5.10": "8.5.10",
      "uuid@<11.1.1": "11.1.1",
      "yaml@>=2.0.0 <2.8.3": "2.9.0",
      "vite@<=6.4.2": "6.4.3",
      "vite@>=7.0.0 <=7.3.4": "7.3.5",
      "vitest@>=4.0.0 <4.1.0": "4.1.0",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "@hono/node-server": ">=1.19.10",
      "axios": ">=1.13.6",
      "express-rate-limit": ">=8.3.0",
      "hono": ">=4.12.5",
      "diff": ">=8.0.3",
      "protobufjs": ">=7.5.5 <8",
      "handlebars": ">=4.7.9 <5",
      "js-yaml@<=4.1.1": "4.2.0"
    }
  }
}
