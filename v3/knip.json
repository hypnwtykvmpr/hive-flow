{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "vitest.config.ts",
        "scripts/**/*.sh"
      ],
      "project": [
        "*.ts",
        "@hive-flow/*/src/**/*.ts",
        "@hive-flow/*/__tests__/**/*.ts",
        "plugins/*/src/**/*.ts",
        "plugins/*/__tests__/**/*.ts",
        "mcp/**/*.ts"
      ],
      "ignore": [
        "**/dist/**",
        "**/node_modules/**",
        "**/.scratch/**",
        "**/.claude/worktrees/**"
      ]
    }
  },
  "ignoreDependencies": [
    "@types/node",
    "@vitest/coverage-v8",
    "semantic-release"
  ],
  "ignoreBinaries": [
    "bats"
  ]
}
