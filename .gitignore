# ============================================================================
# PRIVATE / LOCAL-ONLY DOCUMENTATION (NEVER COMMIT)
# ----------------------------------------------------------------------------
# Project policy: plans, design decisions, ideas, research notes, audit
# reports, postmortems, and chain-of-custody artifacts stay LOCAL ONLY.
# Only README.md, CLAUDE.md, and AGENTS.md may be tracked at the repo root.
# Anything else under these patterns is private and must not enter origin.
# ============================================================================

# Chain-of-custody / planning / research artifacts
/plans/
/plans/*
/.plans/
/.plans/*

# Design documents and improvement proposals
/.claude/design/
/.claude/design/*

# Audit reports and investigations
/.audit/
/.audit/*
/.dox/
/.gemini/
/v3/**/IMPROVEMENT_SUGGESTIONS.md
/v3/**/improvement_suggestions.md

# Root-level *.md files are private by default.
# Only the three permitted instruction docs are allowed.
/*.md
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/CLAUDE.local.md

# Tooling state and plugin scratch
/.lavra/
/.lavra/*
/.spec-workflow/
/.spec-workflow/*

# Scratch directory — official home for one-off investigation artifacts
/.scratch/
/.scratch/*

