{
  "name": "hive-flow",
  "version": "3.1.0-alpha.52",
  "description": "Enterprise AI agent orchestration for Claude Code - Deploy 60+ specialized agents in coordinated swarms with self-learning, fault-tolerant consensus, vector memory, and MCP integration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hive-flow": "./bin/cli.js"
  },
  "files": [
    "bin/**",
    "v3/@hive-flow/cli/bin/**",
    "v3/@hive-flow/cli/dist/**/*.js",
    "v3/@hive-flow/cli/dist/**/*.d.ts",
    "v3/@hive-flow/cli/dist/credential-store/helpers/**",
    "!v3/@hive-flow/cli/dist/**/*.map",
    "v3/@hive-flow/cli/package.json",
    "v3/@hive-flow/cli/agents/**/*.yaml",
    "v3/@hive-flow/cli/.claude/commands/**",
    "v3/@hive-flow/cli/.claude/helpers/**",
    "v3/@hive-flow/cli/.claude/skills/**",
    "v3/@hive-flow/cli/.claude/settings.json",
    "v3/@hive-flow/shared/dist/**/*.js",
    "v3/@hive-flow/shared/dist/**/*.d.ts",
    "!v3/@hive-flow/shared/dist/**/*.map",
    "v3/@hive-flow/shared/package.json",
    "v3/@hive-flow/guidance/dist/**/*.js",
    "v3/@hive-flow/guidance/dist/**/*.d.ts",
    "!v3/@hive-flow/guidance/dist/**/*.map",
    "v3/@hive-flow/guidance/package.json",
    ".claude-plugin/**",
    "!**/DELETE_*",
    "!**/.hive-flow/**",
    "!**/*.db",
    "!**/*.db-shm",
    "!**/*.db-wal",
    "!**/*.db-journal",
    "!**/.context-tracker.json",
    "!**/checkpoints/**",
    "!**/*.map",
    "!TRASH/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node -e \"var f=require('fs'),p=require('path'),o=require('os'),h=o.homedir(),d=p.join(h,'.npm','_npx');try{if(f.existsSync(d))f.readdirSync(d).forEach(function(x){var nm=p.join(d,x,'node_modules');try{if(f.existsSync(nm))f.readdirSync(nm).forEach(function(e){if(e.charAt(0)==='.'&&e.indexOf('-')>0&&/[A-Za-z]{8}/.test(e)){try{var t=p.join(nm,e);if(f.statSync(t).isDirectory())f.rmSync(t,{recursive:true,force:true})}catch(x){}}})}catch(x){}})}catch(x){}try{var ci=p.join(h,'.npm','_cacache','index-v5');if(f.existsSync(ci)){(function walk(dir){f.readdirSync(dir).forEach(function(e){var fp=p.join(dir,e);try{if(f.statSync(fp).isDirectory())walk(fp);else{var c=f.readFileSync(fp,'utf-8');if(c.indexOf('hive-flow')!==-1)f.unlinkSync(fp)}}catch(x){}});})(ci)}}catch(x){}\" || true",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:ts": "cd v3/@hive-flow/cli && npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:security": "vitest run v3/__tests__/security/",
    "lint": "cd v3/@hive-flow/cli && npm run lint",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "security:test": "npm run test:security",
    "v3:domains": "npm run build:domains",
    "v3:swarm": "npm run start:swarm",
    "v3:security": "npm run security:audit && npm run security:test",
    "postinstall": "node v3/@hive-flow/cli/dist/src/install/postinstall-check.js || exit 0"
  },
  "dependencies": {
    "semver": "^7.6.0",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "@ruvector/attention": "^0.1.3",
    "@ruvector/core": "^0.1.30",
    "@ruvector/router": "^0.1.27",
    "@ruvector/router-linux-x64-gnu": "^0.1.27",
    "@ruvector/sona": "^0.1.5",
    "agentdb": "^3.0.0-alpha.9",
    "agentic-flow": "^2.0.7"
  },
  "overrides": {
    "hono": ">=4.12.4",
    "tar": ">=6.2.1",
    "undici": ">=7.26.0 <8",
    "@modelcontextprotocol/sdk": ">=1.25.2",
    "glob": ">=10.0.0"
  },
  "devDependencies": {
    "@openai/codex": "^0.98.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "hive-flow",
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "swarm-intelligence",
    "swarm",
    "mcp",
    "model-context-protocol",
    "llm",
    "large-language-model",
    "gpt",
    "chatgpt",
    "automation",
    "workflow",
    "orchestration",
    "cli",
    "developer-tools",
    "devtools",
    "coding-assistant",
    "code-generation",
    "enterprise",
    "vector-database",
    "embeddings",
    "machine-learning",
    "neural-network",
    "hive-mind",
    "distributed-systems",
    "consensus",
    "self-learning"
  ],
  "contributors": [
    {
      "name": "Hive Flow"
    }
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
