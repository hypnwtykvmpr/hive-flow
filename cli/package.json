  "scripts": {
    "build:helpers-src": "node scripts/copy-helper-sources.mjs",
    "build:guidance-assets": "node scripts/copy-guidance-assets.mjs",
    "build": "npm run clean:dist && tsc && npm run build:helpers-src && npm run build:guidance-assets && node scripts/sync-engine-anchor.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "sync:engine": "node scripts/sync-engine-anchor.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e:anti-mock": "vitest run --config e2e/vitest.config.ts __tests__/anti-mock-theater.test.ts",
    "test:debrand-assert-zero": "vitest run src/init/__tests__/debrand-generator-output.test.ts src/init/__tests__/perf-claims-grep-zero.test.ts src/init/__tests__/dropped-integration-grep-zero.test.ts src/init/__tests__/debrand-static-grep-zero.test.ts src/init/__tests__/debrand-ru-suspect-classification.test.ts src/init/__tests__/debrand-repository-wide-classification.test.ts",
    "test:property": "vitest run src/statusline/__tests__/property-contracts.test.ts",
    "test:sentinel": "vitest run src/__tests__/sentinel-rewake.test.ts src/__tests__/mcp-server-notifications.test.ts",
    "test:enforcement": "vitest run src/__tests__/band1-enforcement.test.ts src/__tests__/role-enforcement.test.ts src/__tests__/pipeline-enforcement.test.ts src/__tests__/enforcement-security-property.test.ts src/__tests__/relocated-engine-root.test.ts",
    "test:testing": "vitest run src/testing/__tests__",
    "test:plugin-store": "tsx src/plugins/tests/standalone-test.ts",
    "test:pattern-store": "tsx src/transfer/store/tests/standalone-test.ts",
    "pack:install-smoke": "npm run build && node scripts/pack-install-smoke.mjs",
    "probe:provider-concurrency": "node scripts/probe-provider-concurrency.mjs",
    "bench:performance": "vitest bench benchmarks/performance",
    "bench:performance:attention": "vitest bench benchmarks/performance/attention",
    "mutation:critical": "stryker run stryker.critical.conf.json",
    "preinstall": "node bin/preinstall.cjs || true",
    "prepublishOnly": "cp ../README.md ./README.md",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "release": "npm version prerelease --preid=alpha && npm run publish:all",
    "publish:all": "./scripts/publish.sh",
    "prepack": "node scripts/stage-bundled-workspaces.mjs",
    "postinstall": "node dist/src/install/postinstall-check.js || exit 0"
  },
