{
  "$schema": "../../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/statusline/storage.ts",
    "src/statusline/ledger-compact.ts",
    "src/integrations/wrapper-driver.ts",
    "src/integrations/integration-marker.ts",
    "src/mcp-tools/mcp-enforcement-gate.ts"
  ],
  "testFiles": [
    "src/statusline/__tests__/storage.test.ts",
    "src/statusline/__tests__/ledger-compact.test.ts",
    "src/integrations/__tests__/wrapper-driver.test.ts",
    "src/integrations/__tests__/integration-marker.test.ts",
    "src/mcp-tools/__tests__/mcp-enforcement-gate.test.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 2,
  "reporters": ["clear-text", "progress", "html"],
  "coverageAnalysis": "off"
}
