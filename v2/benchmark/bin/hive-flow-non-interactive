#!/bin/bash
# Hive Flow Non-Interactive Wrapper
# Ensures all hive-flow commands run in non-interactive mode

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
HIVE_FLOW_PATH="${SCRIPT_DIR}/../../hive-flow"

# Check if hive-flow exists
if [ ! -f "$HIVE_FLOW_PATH" ]; then
    echo "❌ Error: hive-flow not found at $HIVE_FLOW_PATH"
    exit 1
fi

# Parse command and add non-interactive flags
COMMAND="$1"
shift

case "$COMMAND" in
    "swarm")
        # Use executor for non-interactive swarm
        exec "$HIVE_FLOW_PATH" swarm "$@" --executor
        ;;
    
    "hive-mind")
        # Use executor for non-interactive hive-mind
        exec "$HIVE_FLOW_PATH" hive-mind "$@" --executor
        ;;
    
    "sparc")
        # SPARC doesn't need special flags for non-interactive
        exec "$HIVE_FLOW_PATH" sparc "$@"
        ;;
    
    "task")
        # Use executor for non-interactive task
        exec "$HIVE_FLOW_PATH" task "$@" --executor
        ;;
    
    *)
        # Pass through other commands as-is
        exec "$HIVE_FLOW_PATH" "$COMMAND" "$@"
        ;;
esac