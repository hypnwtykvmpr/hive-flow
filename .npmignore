# Source maps - not needed for production (saves 464 files, ~33% size reduction)
**/*.map
**/*.js.map
**/*.d.ts.map

# Development files
**/__tests__/**
**/*.test.ts
**/*.spec.ts
**/vitest.config.*
**/.eslintrc.*
**/tsconfig.json
**/jest.config.*

# Build artifacts
**/node_modules/**
**/.turbo/**
**/.cache/**

# Database files (user-specific)
**/*.db
**/*.db-shm
**/*.db-wal
**/hnsw.index
**/hnsw.metadata.json

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# V2 legacy retired to TRASH/posture-20260613/v2/ (quarantined; covered by TRASH/ rules below)
v2/

# Development docs
docs/
*.md
!README.md
!LICENSE

# Git
.git/
.gitignore
.github/

# Temporary
tmp/
temp/
*.tmp
*.log

# Local/private agent runtime and investigation state
.hive-flow/
**/.hive-flow/
.omc/
**/.omc/
.tmp-*/
**/.tmp-*/
.audit/
.dox/
.private/
.codex/
.gemini/
.opencode/
.qwen/
.resources/
.scratch/

# Quarantine — human-marked DELETE_ files (tracked for restore, never shipped)
TRASH/
**/TRASH/
**/DELETE_*
