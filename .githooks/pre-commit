#!/usr/bin/env bash
set -euo pipefail

echo "Running staged secret check..."

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "pre-commit must run inside a git worktree" >&2
  exit 1
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACMR --)"
if [ -z "$staged_files" ]; then
  echo "No staged files to scan."
  exit 0
fi

secret_pattern='(-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{40,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,})'
found=0

while IFS= read -r file; do
  [ -n "$file" ] || continue
  if ! git cat-file -e ":${file}" 2>/dev/null; then
    continue
  fi
  if git grep --cached -I -n -E "$secret_pattern" -- "$file"; then
    found=1
  fi
done <<< "$staged_files"

if [ "$found" -ne 0 ]; then
  echo ""
  echo "COMMIT BLOCKED - high-confidence secret material detected in staged content." >&2
  echo "Remove the secret or explicitly document a false positive before committing." >&2
  exit 1
fi

echo "Staged secret check passed."
